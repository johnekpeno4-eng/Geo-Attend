# Copy this file to .env and replace the placeholder values with your SMTP provider settings.
# Do not commit the .env file or real credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
MAIL_FROM=GeoAttend <your-email@example.com>

# Camera fingerprint check-in. Give the hotspot token to students for the current class.
CHECKIN_HOTSPOT_TOKEN=replace-with-a-long-random-token-at-least-16-characters
# Generate a base64 encoded 32-byte key; never commit the real value.
FINGERPRINT_TEMPLATE_KEY=replace-with-base64-encoded-32-byte-secret
# Share this only with the loopback matcher service; minimum 32 characters.
FINGERPRINT_MATCHER_TOKEN=replace-with-a-separate-long-random-secret
FINGERPRINT_MATCHER_URL=http://127.0.0.1:5512
FINGERPRINT_MATCHER_PORT=5512
FINGERPRINT_SCORE_THRESHOLD=40
FINGERPRINT_MIN_SHARPNESS=8
FINGERPRINT_CAMERA_DPI=500

